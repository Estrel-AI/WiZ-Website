NEXT_PUBLIC_PAYMENTS_API_BASE_URL=https://payments-test.wiiz.it
NEXT_PUBLIC_FRONTEND_BASE_URL=https://test.wiiz.it
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAN_CODE_STARTER_MONTHLY=WIIZ_STARTER_MONTHLY_TEST
NEXT_PUBLIC_PLAN_CODE_STARTER_ANNUAL=WIIZ_STARTER_ANNUAL_TEST
NEXT_PUBLIC_PLAN_CODE_FREE_TRIAL=WIIZ_FREE_TRIAL_TEST
NEXT_PUBLIC_PLAN_CODE_BUSINESS_ENTRY_MONTHLY=WIIZ_MONTHLY_BUSINESS_ENTRY_PLAN_V2_DEV
NEXT_PUBLIC_PLAN_CODE_BUSINESS_ENTRY_ANNUAL=WIIZ_ANNUAL_BUSINESS_ENTRY_PLAN_V2_DEV
